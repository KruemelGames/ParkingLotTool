<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <ReceiptQuelle Condition="'$(ReceiptQuelle)' == ''">../../Tools/ParkingLotBuildReceipt.cs</ReceiptQuelle>
    <RueckwegQuelle Condition="'$(RueckwegQuelle)' == ''">../../Tools/ParkingLotRueckwegDaten.cs</RueckwegQuelle>
    <ZwischenbauQuelle Condition="'$(ZwischenbauQuelle)' == ''">../../Tools/ParkingLotGespeicherterZwischenbau.cs</ZwischenbauQuelle>
    <StufeAQuelle Condition="'$(StufeAQuelle)' == ''">../../Tools/ParkingLotStufeAPrefabID.cs</StufeAQuelle>
    <EditSectionQuelle Condition="'$(EditSectionQuelle)' == ''">../../Tools/ParkingLotEditSection.Freigabe.cs</EditSectionQuelle>
    <EditQuelle Condition="'$(EditQuelle)' == ''">../../Geometry/EditFreigabe.cs</EditQuelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EditContainer.cs" /><Compile Include="EditAnzeige.cs" />
    <Compile Include="../../Tools/ParkingLotEditSection.cs" Link="ParkingLotEditSection.cs" />
    <Compile Include="$(EditSectionQuelle)" Link="ParkingLotEditSection.Freigabe.cs" />
    <Compile Include="Program.cs" /><Compile Include="Container.cs" /><Compile Include="Feldstrom.cs" />
    <Compile Include="../../Geometry/*.cs" Exclude="../../Geometry/EditFreigabe.cs" Link="Geometry/%(Filename)%(Extension)" />
    <Compile Include="../../Geometry/Zellen/*.cs" Link="Geometry/Zellen/%(Filename)%(Extension)" />
    <Compile Include="$(ReceiptQuelle)" Link="ParkingLotBuildReceipt.cs" />
    <Compile Include="$(RueckwegQuelle)" Link="ParkingLotRueckwegDaten.cs" />
    <Compile Include="$(ZwischenbauQuelle)" Link="ParkingLotGespeicherterZwischenbau.cs" />
    <Compile Include="$(StufeAQuelle)" Link="ParkingLotStufeAPrefabID.cs" />
    <Compile Include="$(EditQuelle)" Link="EditFreigabe.cs" />
    <Compile Include="../../Tools/ParkingLotPrefabname.cs" Link="ParkingLotPrefabname.cs" />
    <Compile Include="../../Tools/ParkingLotAbrissabsicht.cs" Link="ParkingLotAbrissabsicht.cs" />
    <Content Include="Fixturen/historisch.json" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Unity.Mathematics"><HintPath>$(CSII_TOOLPATH)/UnityModsProject/Library/ScriptAssemblies/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
