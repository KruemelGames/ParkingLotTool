<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BegleiterQuelle Condition="'$(BegleiterQuelle)' == ''">../../Geometry/BegleiterAnbindung.cs</BegleiterQuelle>
    <WacheQuelle Condition="'$(WacheQuelle)' == ''">../../Geometry/SyncWache.cs</WacheQuelle>
    <AbschlussQuelle Condition="'$(AbschlussQuelle)' == ''">../../Tools/ParkingLotHintergrundAbschluss.cs</AbschlussQuelle>
    <TauschQuelle Condition="'$(TauschQuelle)' == ''">../../Tools/ParkingLotFahrwegTauschSystem.cs</TauschQuelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="Stubs.cs" />
    <Compile Include="$(BegleiterQuelle)" Link="BegleiterAnbindung.cs" />
    <Compile Include="$(WacheQuelle)" Link="SyncWache.cs" />
    <Compile Include="$(TauschQuelle)" Link="ParkingLotFahrwegTauschSystem.cs" />
    <Compile Include="../../Tools/ParkingLotSyncGueltigkeit.cs" Link="ParkingLotSyncGueltigkeit.cs" />
    <Compile Include="$(AbschlussQuelle)" Link="ParkingLotHintergrundAbschluss.cs" />
    <Compile Include="../../Tools/ParkingLotFahrregeln.cs" Link="ParkingLotFahrregeln.cs" />
    <Reference Include="Unity.Mathematics">
      <HintPath>$(CSII_TOOLPATH)/UnityModsProject/Library/ScriptAssemblies/Unity.Mathematics.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
