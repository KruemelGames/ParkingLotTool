<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>disable</Nullable>
    <GriffQuelle Condition="'$(GriffQuelle)' == ''">../../Geometry/Vorschaugriff.cs</GriffQuelle>
    <EchteQuelle Condition="'$(EchteQuelle)' == ''">../../Geometry/EchteVorschau.cs</EchteQuelle>
    <MusterArchetypQuelle Condition="'$(MusterArchetypQuelle)' == ''">../../Tools/ParkingLotMusterobjektArchetyp.cs</MusterArchetypQuelle>
    <VorschauEinstellungQuelle Condition="'$(VorschauEinstellungQuelle)' == ''">../../Tools/ParkingLotEchteVorschauEinstellung.cs</VorschauEinstellungQuelle>
    <SpielManaged Condition="'$(CSII_MANAGEDPATH)' != ''">$(CSII_MANAGEDPATH)</SpielManaged>
    <SpielManaged Condition="'$(SpielManaged)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</SpielManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MusterArchetypQuelle)" Link="MusterobjektArchetyp.cs" />
    <Compile Include="Archetyp.cs" />
    <Compile Include="Program.cs" /><Compile Include="Program.Griff.cs" /><Compile Include="DefaultsLeser.cs" />
    <Compile Include="$(GriffQuelle)" Link="Vorschaugriff.cs" />
    <Compile Include="$(VorschauEinstellungQuelle)" Link="ParkingLotEchteVorschauEinstellung.cs" />
    <Compile Include="$(EchteQuelle)" Link="EchteVorschau.cs" />
    <Compile Include="../../Geometry/**/*.cs" Exclude="../../Geometry/EchteVorschau.cs;../../Geometry/Vorschaugriff.cs" />
    <Reference Include="Unity.Mathematics"><HintPath>$(CSII_TOOLPATH)/UnityModsProject/Library/ScriptAssemblies/Unity.Mathematics.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SpielManaged)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
