<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <BaukontextLeserQuelle Condition="'$(BaukontextLeserQuelle)' == ''">../../Tools/ParkingLotBaukontextLeser.cs</BaukontextLeserQuelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Geometry/*.cs" Link="Geometry/%(Filename)%(Extension)" />
    <Compile Include="../../Geometry/Zellen/*.cs" Link="Geometry/Zellen/%(Filename)%(Extension)" />
    <Compile Include="../../Tools/ParkingLotBuildReceipt.cs" Link="ParkingLotBuildReceipt.cs" />
    <Compile Include="../../Tools/ParkingLotBaukontext.cs" Link="ParkingLotBaukontext.cs" />
    <Compile Include="../../Tools/ParkingLotKurvenzettelPuffer.cs" Link="ParkingLotKurvenzettelPuffer.cs" />
    <Compile Include="$(BaukontextLeserQuelle)" Link="ParkingLotBaukontextLeser.cs" />
    <Reference Include="Unity.Mathematics"><HintPath>$(CSII_TOOLPATH)/UnityModsProject/Library/ScriptAssemblies/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
